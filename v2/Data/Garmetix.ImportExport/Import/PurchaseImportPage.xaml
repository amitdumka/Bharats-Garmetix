<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Garmetix.POS.Desktop.ViewModels"
             x:Class="Garmetix.POS.Desktop.Views.PurchaseImportPage"
             Title="Purchase &amp; Inward Import"
             BackgroundColor="#F1F5F9">

    <ContentPage.BindingContext>
        <vm:PurchaseImportViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="40" MaximumWidthRequest="800" HorizontalOptions="Center">

            <Label Text="Purchase &amp; Inward Import Tool" FontSize="28" FontAttributes="Bold" TextColor="#0F172A" />
            <Label Text="Import products, stocks, and vendor purchase invoices from Excel. Data is backed up to JSON before processing." 
                   FontSize="14" TextColor="#64748B" Margin="0,0,0,10"/>

            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="25">
                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="1. Source Data (Excel)" FontAttributes="Bold" TextColor="#334155"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0" Text="{Binding SelectedExcelFilePath}" IsReadOnly="True" 
                                   Placeholder="Select .xlsx file..." BackgroundColor="#F8FAFC" TextColor="#334155"/>
                            <Button Grid.Column="1" Text="Browse File" Command="{Binding SelectExcelFileCommand}" 
                                    BackgroundColor="#2563EB" TextColor="White" CornerRadius="6"/>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="2. JSON Output Location (Backup)" FontAttributes="Bold" TextColor="#334155"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0" Text="{Binding OutputDirectoryPath}" IsReadOnly="True" 
                                   BackgroundColor="#F8FAFC" TextColor="#334155"/>
                            <Button Grid.Column="1" Text="Change Folder" Command="{Binding SelectOutputFolderCommand}" 
                                    BackgroundColor="#64748B" TextColor="White" CornerRadius="6"/>
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,10"/>

                    <Label Text="3. Database Target Operations" FontAttributes="Bold" TextColor="#334155"/>
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding ImportProducts}" Color="#2563EB" />
                            <Label Text="Create new Products / Update existing Masters" VerticalOptions="Center" TextColor="#0F172A"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding ImportStock}" Color="#2563EB" />
                            <Label Text="Update Inventory Stock Quantities &amp; Values" VerticalOptions="Center" TextColor="#0F172A"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding ImportPurchaseInvoices}" Color="#2563EB" />
                            <Label Text="Generate Purchase Invoices &amp; Vendor Liabilities" VerticalOptions="Center" TextColor="#0F172A"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Execute Data Import" Command="{Binding StartImportCommand}" 
                    BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" FontSize="16" HeightRequest="50" CornerRadius="8">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsProcessing}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Text" Value="Processing Data..." />
                        <Setter Property="BackgroundColor" Value="#9CA3AF" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="15">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsProcessing}" IsVisible="{Binding IsProcessing}" Color="White" HeightRequest="20" WidthRequest="20"/>
                    <Label Text="{Binding StatusMessage}" TextColor="#E2E8F0" FontFamily="Consolas" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>