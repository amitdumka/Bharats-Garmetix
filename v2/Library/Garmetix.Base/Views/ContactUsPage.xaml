<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.Base.Views.ContactUsPage"
             Title="Contact &amp; Support"
             BackgroundColor="#F4F6F9">

    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="ActionCard">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.2" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Store Location" FontSize="13" FontAttributes="Bold" TextColor="#6C757D" TextTransform="Uppercase" Margin="5,10,0,5" />
            <Border Style="{StaticResource ActionCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="📍" FontSize="24" VerticalOptions="Center" Grid.Column="0" Margin="0,0,15,0" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding StoreName}" FontSize="16" FontAttributes="Bold" TextColor="#2C3E50" />
                        <Label Text="{Binding Address}" FontSize="13" TextColor="#6C757D" Margin="0,3,0,0" />
                        <Label Text="Tap to open in Google Maps" FontSize="11" TextColor="#005A9C" FontAttributes="Italic" Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Direct Support" FontSize="13" FontAttributes="Bold" TextColor="#6C757D" TextTransform="Uppercase" Margin="5,15,0,5" />

            <Border Style="{StaticResource ActionCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CallPhoneCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Text="📞" FontSize="20" VerticalOptions="Center" Grid.Column="0" Margin="0,0,15,0" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Phone Number" FontSize="12" TextColor="#868E96" />
                        <Label Text="{Binding Phone}" FontSize="16" FontAttributes="Bold" TextColor="#2C3E50" />
                    </VerticalStackLayout>
                    <Label Text="CALL" FontSize="12" FontAttributes="Bold" TextColor="#005A9C" VerticalOptions="Center" Grid.Column="2" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ActionCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendEmailCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Text="✉️" FontSize="20" VerticalOptions="Center" Grid.Column="0" Margin="0,0,15,0" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Email Address" FontSize="12" TextColor="#868E96" />
                        <Label Text="{Binding Email}" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                    </VerticalStackLayout>
                    <Label Text="EMAIL" FontSize="12" FontAttributes="Bold" TextColor="#005A9C" VerticalOptions="Center" Grid.Column="2" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>