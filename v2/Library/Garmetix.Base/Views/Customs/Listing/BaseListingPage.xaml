<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Garmetix.Base.Views.Customs.Listing.BaseListingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:viewmodels="clr-namespace:Garmetix.Base.PageModels"
    x:Name="CPage"
    Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Order="Primary" Text="Export">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    FontFamily="MaterialDesignIcons"
                    Glyph="&#xF0453;"
                    Size="24"
                    Color="Black" />
                <!--  Export icon (e.g., 'Download')  -->
            </ToolbarItem.IconImageSource>
            <ToolbarItem.Command>
                <Binding Path="ExportToExcelCommand" />
            </ToolbarItem.Command>
        </ToolbarItem>
        <ToolbarItem Order="Primary" Text="Import">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    FontFamily="MaterialDesignIcons"
                    Glyph="&#xF044D;"
                    Size="24"
                    Color="Black" />
                <!--  Import icon (e.g., 'Upload')  -->
            </ToolbarItem.IconImageSource>
            <ToolbarItem.Command>
                <Binding Path="ImportFromExcelCommand" />
            </ToolbarItem.Command>
        </ToolbarItem>

        <!--  Json  -->
        <ToolbarItem Order="Secondary" Text="Export JSON">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    FontFamily="MaterialDesignIcons"
                    Glyph="&#xF039C;"
                    Size="24"
                    Color="Black" />

            </ToolbarItem.IconImageSource>
            <ToolbarItem.Command>
                <Binding Path="ExportJsonCommand" />
            </ToolbarItem.Command>
        </ToolbarItem>
        <ToolbarItem Order="Secondary" Text="Import JSON">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    FontFamily="MaterialDesignIcons"
                    Glyph="&#xF039B;"
                    Size="24"
                    Color="Black" />

            </ToolbarItem.IconImageSource>
            <ToolbarItem.Command>
                <Binding Path="ImportJsonCommand" />
            </ToolbarItem.Command>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CPage}}"
            Command="{Binding NavigatedToCommand}"
            EventName="NavigatedTo" />

        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CPage}}"
            Command="{Binding NavigatedFromCommand}"
            EventName="NavigatedFrom" />

        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CPage}}"
            Command="{Binding AppearingCommand}"
            EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <AbsoluteLayout>

            <RefreshView
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                Command="{Binding LoadInitialDataCommand}"
                IsRefreshing="{Binding IsBusy}">

                <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label
                        Margin="0,0,-10,-10"
                        FontAttributes="Bold"
                        FontSize="Title"
                        HorizontalOptions="Center"
                        Text="{Binding Title, Converter={StaticResource PascalCaseToWordsConverter}}"
                        TextColor="{AppThemeBinding Dark={DynamicResource ContentTextColorDark},
                                                    Light={DynamicResource ContentTextColorLight}}" />
                    <Border
                        Grid.Row="1"
                        Margin="10,-10"
                        Padding="10"
                        HeightRequest="500"
                        StrokeShape="RoundRectangle 8"
                        Style="{StaticResource CardStyle}">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.3"
                                Radius="10"
                                Offset="0,4" />
                        </Border.Shadow>

                        <VerticalStackLayout Margin="-20,-20" VerticalOptions="Start">
                            <syncfusion:SfDataGrid
                                x:Name="dataGrid"
                                Margin="10,0,10,10"
                                AllowResizingColumns="True"
                                AllowSwiping="True"
                                AllowTriStateSorting="True"
                                AutoGenerateColumnsMode="None"
                                AutoGenerateColumnsModeForCustomType="Both"
                                ColumnWidthMode="Auto"
                                Columns="{Binding GridColumns}"
                                DataFetchSize="10"
                                HeightRequest="510"
                                HorizontalOptions="Center"
                                HorizontalScrollBarVisibility="Always"
                                ItemsSource="{Binding Source={x:Reference dataPager}, Path=PagedSource}"
                                PullToRefreshCommand="{Binding RefreshCommand}"
                                RowHeight="58"
                                SelectionChanged="OnSelectionChanged"
                                SelectionMode="Single"
                                ShowSortNumbers="True"
                                SortingMode="Multiple"
                                SwipeEnded="Datagrid_SwipeEnded"
                                TransitionType="SlideOnTop"
                                VerticalScrollBarVisibility="Always">

                                <syncfusion:SfDataGrid.DefaultStyle>
                                    <syncfusion:DataGridStyle
                                        AlternateRowBackground="{AppThemeBinding Light=#F2F2F2,
                                                                                 Dark=#1A1A1A}"
                                        GridLineColor="{AppThemeBinding Light=#CCCCCC,
                                                                        Dark=#444444}"
                                        HeaderRowBackground="{AppThemeBinding Light=White,
                                                                              Dark=Black}"
                                        HeaderRowFontAttributes="Bold"
                                        HeaderRowFontFamily="Roboto-Medium"
                                        HeaderRowFontSize="15"
                                        HeaderRowTextColor="{AppThemeBinding Light=Black,
                                                                             Dark=White}"
                                        RowBackground="{AppThemeBinding Light=White,
                                                                        Dark=Black}"
                                        RowFontSize="14"
                                        RowTextColor="{AppThemeBinding Light=Black,
                                                                       Dark=White}"
                                        SelectedRowTextColor="{AppThemeBinding Light=Black,
                                                                               Dark=White}"
                                        SelectionBackground="{AppThemeBinding Light=#E0E0E0,
                                                                              Dark=#333333}" />
                                </syncfusion:SfDataGrid.DefaultStyle>
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PageModelBase}}, Path=EditCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Edit" />
                                        <MenuFlyoutItem
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PageModelBase}}, Path=DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Delete" />
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                                <!--  Define the Right Swipe Template for the 'Edit' action  -->
                                <syncfusion:SfDataGrid.RightSwipeTemplate>
                                    <DataTemplate>
                                        <Grid Padding="20,0" BackgroundColor="#007BFF">
                                            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                                <Image
                                                    HeightRequest="25"
                                                    Source="edit_icon.png"
                                                    WidthRequest="25" />
                                            </Grid>
                                            <Button
                                                BackgroundColor="Transparent"
                                                Command="{Binding Source={x:Reference dataGrid}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding .}"
                                                Text="Edit"
                                                TextColor="Transparent" />
                                        </Grid>
                                    </DataTemplate>
                                </syncfusion:SfDataGrid.RightSwipeTemplate>
                                <!--  Define the Left Swipe Template for the 'Delete' action  -->
                                <syncfusion:SfDataGrid.LeftSwipeTemplate>
                                    <DataTemplate>
                                        <Grid Padding="20,0" BackgroundColor="#DC3545">
                                            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                                <Image
                                                    HeightRequest="25"
                                                    Source="delete_icon.png"
                                                    WidthRequest="25" />
                                            </Grid>
                                            <Button
                                                BackgroundColor="Transparent"
                                                Command="{Binding Source={x:Reference dataGrid}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}"
                                                Text="Delete"
                                                TextColor="Transparent" />
                                        </Grid>
                                    </DataTemplate>
                                </syncfusion:SfDataGrid.LeftSwipeTemplate>

                            </syncfusion:SfDataGrid>
                        </VerticalStackLayout>
                    </Border>
                    <pager:SfDataPager
                        x:Name="dataPager"
                        Grid.Row="2"
                        Margin="0,0,0,10"
                        AutoEllipsisMode="After"
                        BackgroundColor="{x:StaticResource BackgroundColorDark}"
                        ButtonShape="Circle"
                        DisplayMode="FirstLastNumeric"
                        HorizontalOptions="Center"
                        NumericButtonCount="10"
                        NumericButtonsGenerateMode="Auto"
                        PageSize="15"
                        Source="{Binding Entities}">
                        <pager:SfDataPager.DefaultStyle>
                            <pager:DataPagerStyle
                                NavigationButtonBackgroundColor="{x:StaticResource Bright-Cyan}"
                                NavigationButtonIconColor="{x:StaticResource Dull-Red}"
                                NumericButtonBackgroundColor="{x:StaticResource Deep-Purple}"
                                NumericButtonSelectionBackgroundColor="{x:StaticResource LightBackground}"
                                NumericButtonTextColor="{x:StaticResource TwitterBlue}" />
                        </pager:SfDataPager.DefaultStyle>
                    </pager:SfDataPager>
                    <!--  A full-page loading indicator for the initial load  -->
                </Grid>
                <!--</VerticalStackLayout>-->
            </RefreshView>

            <Button
                Margin="0,0,2,2"
                AbsoluteLayout.LayoutBounds="1,1,AutoSize,AutoSize"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                BackgroundColor="Green"
                Command="{Binding AddButtonCommand}"
                CornerRadius="50"
                FontSize="Large"
                HeightRequest="60"
                IsEnabled="{Binding EnableAdd}"
                IsVisible="{Binding EnableAdd}"
                Text="+"
                TextColor="White"
                WidthRequest="60" />
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>