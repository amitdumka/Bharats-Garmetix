<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Garmetix.Core.Views.Customs.Forms.EntryFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:button="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
    x:Name="EntryFormViews">
    <ContentView.Content>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Aspect="Fill"
                IsVisible="{OnPlatform Default=false,
                                       WinUI=True,
                                       MacCatalyst=true}"
                Source="{Binding Source={x:Reference EntryFormViews}, Path=SideImage}" />


            <Grid
                Grid.Column="{OnPlatform Default=1,
                                         Android=0,
                                         iOS=0}"
                Grid.ColumnSpan="{OnPlatform Default=2,
                                             WinUI=0,
                                             MacCatalyst=0}"
                Margin="{OnPlatform Default=30,
                                    Android=10,
                                    iOS=10}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Margin="-20,-30,0,0"
                    Padding="20"
                    Background="{AppThemeBinding Dark={DynamicResource DarkSecondaryBackground},
                                                 Light={DynamicResource LightSecondaryBackground}}"
                    HorizontalOptions="End"
                    StrokeLineCap="Square"
                    VerticalOptions="Start">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start">

                        <Label
                            Margin="{OnPlatform iOS=5,
                                                Android=5,
                                                Default='-10,-10,-10,10'}"
                            FontFamily="Roboto-Medium"
                            FontSize="Small"
                            HorizontalOptions="Center"
                            Text="{Binding Source={x:Reference EntryFormViews}, Path=Title}"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                        Dark={DynamicResource PrimaryTextColorDark}}" />
                        <dataForm:SfDataForm
                            x:Name="dataForm"
                            Margin="{OnPlatform iOS='-5,1,-10,5',
                                                Android='-5,1,-10,5',
                                                Default='-10,-10,-10,5'}"
                            ColumnCount="{Binding Source={x:Reference EntryFormViews}, Path=ColumnCount}"
                            CommitMode="PropertyChanged"
                            DataObject="{Binding Entity}"
                            LayoutType="TextInputLayout"
                            MinimumHeightRequest="480"
                            ValidationMode="{Binding Source={x:Reference EntryFormViews}, Path=ValidationMode}">

                            <dataForm:SfDataForm.TextInputLayoutSettings>
                                <dataForm:TextInputLayoutSettings OutlineCornerRadius="5" ShowHelperText="True">
                                    <dataForm:TextInputLayoutSettings.HelperTextStyle>
                                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                                    </dataForm:TextInputLayoutSettings.HelperTextStyle>
                                </dataForm:TextInputLayoutSettings>
                            </dataForm:SfDataForm.TextInputLayoutSettings>
                            <dataForm:SfDataForm.ErrorLabelTextStyle>
                                <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                            </dataForm:SfDataForm.ErrorLabelTextStyle>
                            <dataForm:SfDataForm.LabelTextStyle>
                                <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}" />
                            </dataForm:SfDataForm.LabelTextStyle>
                            <dataForm:SfDataForm.ValidMessageLabelTextStyle>
                                <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                            </dataForm:SfDataForm.ValidMessageLabelTextStyle>
                            <dataForm:SfDataForm.EditorTextStyle>
                                <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />
                            </dataForm:SfDataForm.EditorTextStyle>
                        </dataForm:SfDataForm>
                    </VerticalStackLayout>
                </Border>

                <ScrollView
                    Grid.Row="1"
                    Margin="10,10,10,10"
                    HorizontalOptions="Center"
                    Orientation="Both"
                    VerticalOptions="End">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <button:SfButton
                            x:Name="submitButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5,0,10,10"
                            Background="{AppThemeBinding Dark={DynamicResource PrimaryDarkenColor},
                                                         Light={DynamicResource PrimaryColorLight}}"
                            Command="{Binding SaveButtonCommand}"
                            EnableRippleEffect="True"
                            HorizontalOptions="Fill"
                            ImageAlignment="Default"
                            ImageSource="save_icon.png"
                            ShowIcon="True"
                            Style="{DynamicResource IconButtonStyle}"
                            TextColor="AliceBlue"
                            ToolTipProperties.Text="Save" />
                        <button:SfButton
                            x:Name="saveNPrintButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5,0,10,10"
                            Background="{DynamicResource Purpleish-Blue}"
                            Command="{Binding SaveNPrintButtonCommand}"
                            EnableRippleEffect="True"
                            HorizontalOptions="Fill"
                            ImageAlignment="Default"
                            ImageSource="print_icon.png"
                            IsEnabled="{Binding EnablePrinting}"
                            IsVisible="{Binding EnablePrinting}"
                            ShowIcon="True"
                            Stroke="White"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTipProperties.Text="Save and Print" />

                        <button:SfButton
                            x:Name="canclelButton"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="5,0,10,10"
                            Background="{DynamicResource Dull-Red}"
                            Command="{Binding CancleCommand}"
                            HorizontalOptions="Fill"
                            ImageAlignment="Default"
                            ImageSource="cancle_icon.png"
                            ShowIcon="True"
                            Stroke="White"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTipProperties.Text="Cancle" />

                        <button:SfButton
                            x:Name="backButton"
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="5,0,10,10"
                            Background="{DynamicResource Gold}"
                            Command="{Binding BackCommand}"
                            HorizontalOptions="Fill"
                            ImageAlignment="Default"
                            ImageSource="back_icon.png"
                            ShowIcon="True"
                            Stroke="White"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTipProperties.Text="Back" />

                        <button:SfButton
                            x:Name="mailIdButton"
                            Grid.Row="{OnIdiom Default=0,
                                               Phone=1,
                                               Tablet=0}"
                            Grid.Column="{OnIdiom Default=4,
                                                  Tablet=4,
                                                  Phone=1}"
                            Margin="5,0,10,10"
                            Background="{DynamicResource FacebookBlue}"
                            Command="{Binding MailItCommand}"
                            EnableRippleEffect="True"
                            HorizontalOptions="Fill"
                            ImageAlignment="Default"
                            ImageSource="email_icon.png"
                            IsEnabled="{Binding CanShare}"
                            IsVisible="{Binding CanShare}"
                            ShowIcon="True"
                            Stroke="White"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTipProperties.Text="Mail" />

                        <button:SfButton
                            x:Name="shareItButton"
                            Grid.Row="{OnIdiom Default=0,
                                               Phone=1,
                                               Tablet=0}"
                            Grid.Column="{OnIdiom Default=5,
                                                  Tablet=5,
                                                  Phone=2}"
                            Margin="5,0,10,10"
                            Background="{AppThemeBinding Dark={DynamicResource TwitterBlue},
                                                         Light={DynamicResource TwitterBlue}}"
                            Command="{Binding ShareItCommand}"
                            EnableRippleEffect="True"
                            HorizontalOptions="Fill"
                            ImageAlignment="Default"
                            ImageSource="share_icon.png"
                            IsEnabled="{Binding CanShare}"
                            IsVisible="{Binding CanShare}"
                            ShowIcon="True"
                            Stroke="White"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTipProperties.Text="Share" />

                    </Grid>
                </ScrollView>

            </Grid>

        </Grid>
    </ContentView.Content>
</ContentView>