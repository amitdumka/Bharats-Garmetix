<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.Base.Views.AboutUsPage"
             Title="About Us"
             BackgroundColor="#F4F6F9">

    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,15" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#1A000000" Offset="0,4" Radius="10" Opacity="0.3" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,20,0,30">
                <Image Source="garmetix_logo.svg" HeightRequest="120" WidthRequest="120" />
            </VerticalStackLayout>

            <Label Text="Software Information" FontSize="13" FontAttributes="Bold" TextColor="#6C757D" TextTransform="Uppercase" Margin="5,0,0,5" />
            <Border Style="{StaticResource CardStyle}">
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="15">
                    <Label Text="Application Name" FontSize="14" TextColor="#868E96" Grid.Row="0" Grid.Column="0"/>
                    <Label Text="{Binding AppName}" FontSize="15" FontAttributes="Bold" TextColor="#2C3E50" Grid.Row="0" Grid.Column="1"/>

                    <Label Text="Current Build" FontSize="14" TextColor="#868E96" Grid.Row="1" Grid.Column="0"/>
                    <Label Text="{Binding Version}" FontSize="15" FontAttributes="Bold" TextColor="#2C3E50" Grid.Row="1" Grid.Column="1"/>

                    <Label Text="Core Developer" FontSize="14" TextColor="#868E96" Grid.Row="2" Grid.Column="0"/>
                    <Label Text="{Binding Developer}" FontSize="15" FontAttributes="Bold" TextColor="#005A9C" Grid.Row="2" Grid.Column="1"/>
                </Grid>
            </Border>

            <Label Text="Licensed To" FontSize="13" FontAttributes="Bold" TextColor="#6C757D" TextTransform="Uppercase" Margin="5,10,0,5" />
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="{Binding ClientName}" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center"/>
                    <Label Text="Exclusive Point of Sale Edition" FontSize="13" TextColor="#868E96" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="1" Color="#F0F2F5" Margin="0,10" />
                    <Label Text="© 2026 Garmetix Core Technologies. All rights reserved." FontSize="11" TextColor="#ADB5BD" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>