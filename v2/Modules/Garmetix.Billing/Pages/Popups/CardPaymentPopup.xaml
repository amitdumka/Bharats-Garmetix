<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:local="clr-namespace:Garmetix.Billing.Pages.Popups" 
                x:Class="Garmetix.Billing.Pages.Popups.CardPaymentPopup"
               x:TypeArguments="local:CardPaymentDetails"
               >

    <Border Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
            WidthRequest="350" StrokeThickness="0" StrokeShape="RoundRectangle 15">

        <VerticalStackLayout Spacing="15">
            <Label Text="💳 Card Payment Details" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />

            <Picker x:Name="CardTypePicker" Title="Select Card Type">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Visa</x:String>
                        <x:String>MasterCard</x:String>
                        <x:String>RuPay</x:String>
                        <x:String>Amex</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry x:Name="LastFourEntry" 
                   Placeholder="Last 4 Digits (e.g., 1234)" 
                   Keyboard="Numeric" 
                   MaxLength="4" />

            <Entry x:Name="AuthCodeEntry" 
                   Placeholder="Auth / Approval Code" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Cancel" Clicked="Cancel_Clicked" BackgroundColor="Transparent" TextColor="Red" />
                <Button Grid.Column="1" Text="Save" Clicked="Save_Clicked" BackgroundColor="#D4AF37" TextColor="Black" FontAttributes="Bold" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>