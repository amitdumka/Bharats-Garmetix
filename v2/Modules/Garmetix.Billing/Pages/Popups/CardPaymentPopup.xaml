<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:Garmetix.Core.Models.Inventory;assembly=Garmetix.Core"
               x:Class="Garmetix.Billing.Pages.Popups.CardPaymentPopup"
               xmlns:local="clr-namespace:Garmetix.Billing.Pages.Popups"                
               x:TypeArguments="local:CardPaymentDto">
    

    <Border Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
            WidthRequest="350" StrokeThickness="0" StrokeShape="RoundRectangle 15">

        <VerticalStackLayout Spacing="15">
            <Label Text="💳 Card Details" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />

            <Picker x:Name="CardModePicker" Title="Select Card Mode" />

            <Picker x:Name="CardTypePicker" Title="Select Network Type" />

            <Entry x:Name="BankNameEntry" 
                   Placeholder="Bank Name (e.g., HDFC, SBI)" />
           
            <Entry x:Name="AmountEntry" 
                   Placeholder="Amount (Numeric)" 
                   Keyboard="Numeric" />

            <Entry x:Name="CardNumberEntry" 
                   Placeholder="Last 4 Digits (Numeric)" 
                   Keyboard="Numeric" 
                   MaxLength="4" />

            <Entry x:Name="AuthCodeEntry" 
                   Placeholder="Auth Code (Numeric)" 
                   Keyboard="Numeric" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
                <Button Grid.Column="0" Text="Cancel" Clicked="Cancel_Clicked" BackgroundColor="Transparent" TextColor="Red" />
                <Button Grid.Column="1" Text="Save" Clicked="Save_Clicked" BackgroundColor="#D4AF37" TextColor="Black" FontAttributes="Bold" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>