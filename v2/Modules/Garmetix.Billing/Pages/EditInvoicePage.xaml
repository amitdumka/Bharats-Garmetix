<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             x:Class="Garmetix.Billing.Pages.EditInvoicePage"
             BackgroundColor="#F4F6F9"
             Title="Edit Invoice">

    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#1A000000" Offset="0,4" Radius="10" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label" x:Key="HeaderLabelStyle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#2C3E50" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="10" IsEnabled="{Binding IsNotBusy}">

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout>
                        <Label Text="Invoice Information" Style="{StaticResource HeaderLabelStyle}" />

                        <Grid ColumnDefinitions="*, *, *" RowSpacing="15" ColumnSpacing="15">
                            <core:SfTextInputLayout Hint="Invoice Number" ContainerType="None" Grid.Column="0">
                                <Entry Text="{Binding CurrentInvoice.InvoiceNumber}" IsReadOnly="True" TextColor="#6C757D" FontAttributes="Bold"/>
                            </core:SfTextInputLayout>

                            <core:SfTextInputLayout Hint="Customer Name" ContainerType="None" Grid.Column="1">
                                <Entry Text="{Binding CurrentInvoice.CustomerName}" />
                            </core:SfTextInputLayout>

                            <core:SfTextInputLayout Hint="Invoice Date" ContainerType="None" Grid.Column="2">
                                <Entry Text="{Binding CurrentInvoice.OnDate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" TextColor="#6C757D"/>
                            </core:SfTextInputLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Item Details (Modifying)" Style="{StaticResource HeaderLabelStyle}" />

                        <HorizontalStackLayout Spacing="15">
                            <inputs:SfAutocomplete 
                                WidthRequest="350" 
                                Placeholder="Scan Barcode or Type Product Name..."
                                ItemsSource="{Binding FilteredProducts}" 
                                DisplayMemberPath="DisplayText" 
                                TextMemberPath="DisplayText"
                                TextSearchMode="Contains"
                                Text="{Binding SearchText, Mode=TwoWay}"
                                SelectedItem="{Binding SelectedProduct}" 
                                HeightRequest="45" 
                                DropDownBackground="#FFFFFF"/>
                        </HorizontalStackLayout>

                        <datagrid:SfDataGrid BackgroundColor="AliceBlue" AllowSelectionOnSecondaryTap="True"  
                                             AllowEditing="True" SelectionMode="Single" NavigationMode="Cell"
                                             HeaderRowHeight="45" RowHeight="50" AutoGenerateColumnsMode="None" 
                                             HeightRequest="300" ItemsSource="{Binding EditItems}" ColumnWidthMode="Fill">
                            <datagrid:SfDataGrid.Columns>
                                <datagrid:DataGridTextColumn MappingName="Barcode" HeaderText="Item Description" Width="200" AllowEditing="False"/>
                                <datagrid:DataGridNumericColumn MappingName="BasePrice" HeaderText="Rate (₹)" Format="N2" AllowEditing="False"/>
                                <datagrid:DataGridNumericColumn MappingName="BilledQuantity" HeaderText="Qty" Format="0.##" AllowEditing="True"/>
                                <datagrid:DataGridNumericColumn MappingName="DiscountPercentage" HeaderText="Disc %" Format="N2" AllowEditing="True"/>
                                <datagrid:DataGridNumericColumn MappingName="DiscountAmount" HeaderText="Disc (₹)" Format="N2" AllowEditing="False"/>
                                <datagrid:DataGridNumericColumn MappingName="GstPercentage" HeaderText="GST %" Format="N0" AllowEditing="False"/>
                                <datagrid:DataGridNumericColumn MappingName="TotalAmount" HeaderText="Amount" Format="N0" AllowEditing="False"/>

                                <datagrid:DataGridTemplateColumn HeaderText="Action" Width="100">
                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Text="✖" BackgroundColor="#FFF1F0" TextColor="#D32F2F" Padding="0" 
                                                    Command="{Binding BindingContext.RemoveItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                    CommandParameter="{Binding .}" HeightRequest="35" WidthRequest="35" CornerRadius="4"/>
                                        </DataTemplate>
                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                </datagrid:DataGridTemplateColumn>
                            </datagrid:SfDataGrid.Columns>
                        </datagrid:SfDataGrid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="3.5*,3.5*, 4.5*" ColumnSpacing="30">

                        <VerticalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="Payment Splitting" Style="{StaticResource HeaderLabelStyle}" FontSize="14"/>

                            <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                                <inputs:SfComboBox Grid.Column="0" SelectedItem="{Binding PaymentModeInput}" HeightRequest="40">
                                    <inputs:SfComboBox.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Cash</x:String>
                                            <x:String>UPI</x:String>
                                            <x:String>Credit Card</x:String>
                                        </x:Array>
                                    </inputs:SfComboBox.ItemsSource>
                                </inputs:SfComboBox>

                                <Entry Grid.Column="1" Placeholder="Amount (₹)" Text="{Binding PaymentAmountInput}" Keyboard="Numeric" HeightRequest="40" BackgroundColor="#F8F9FA"/>
                                <Button Grid.Column="2" Text="Add" Command="{Binding AddPaymentCommand}" HeightRequest="40" BackgroundColor="#6C757D" TextColor="White" CornerRadius="4"/>
                            </Grid>

                            <CollectionView ItemsSource="{Binding Payments}" HeightRequest="90" Margin="0,5,0,0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Stroke="#E0E0E0" StrokeThickness="1" Padding="10,5" Margin="0,0,0,5" StrokeShape="RoundRectangle 4" BackgroundColor="#FCFCFC">
                                            <Grid ColumnDefinitions="*, *, Auto">
                                                <Label Text="{Binding Mode}" Grid.Column="0" FontSize="13" VerticalOptions="Center" TextColor="#495057"/>
                                                <Label Text="{Binding Amount, StringFormat='₹ {0:F2}'}" Grid.Column="1" FontSize="13" VerticalOptions="Center" FontAttributes="Bold" TextColor="#212529"/>
                                                <Button Text="✖" Grid.Column="2" WidthRequest="25" HeightRequest="25" Padding="0" BackgroundColor="Transparent" TextColor="#D32F2F" FontSize="12" FontAttributes="Bold"
                                                        Command="{Binding BindingContext.RemovePaymentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Label Text="{Binding BalanceAmount, StringFormat='Pending Balance: ₹ {0:F2}'}" TextColor="#D32F2F" FontAttributes="Bold" FontSize="14"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Fill" VerticalOptions="End">

                            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                <Label Text="Sub Total:" FontSize="13" TextColor="#6C757D" VerticalOptions="Center"/>
                                <Label Text="{Binding SubTotal, StringFormat='₹ {0:F2}'}" FontSize="13" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                <Label Text="Total GST:" FontSize="13" TextColor="#6C757D" VerticalOptions="Center"/>
                                <Label Text="{Binding TotalTax, StringFormat='₹ {0:F2}'}" FontSize="13" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,8">
                                <Label Text="Bill Discount:" FontSize="13" TextColor="#2C3E50" FontAttributes="Bold" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End">
                                    <Entry Text="{Binding GlobalDiscountInput}" Keyboard="Numeric" WidthRequest="70" HeightRequest="35" FontSize="13" BackgroundColor="#F4F6F9"/>
                                    <inputs:SfComboBox SelectedItem="{Binding GlobalDiscountTypeInput}" WidthRequest="125" HeightRequest="35">
                                        <inputs:SfComboBox.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Amount</x:String>
                                                <x:String>%</x:String>
                                            </x:Array>
                                        </inputs:SfComboBox.ItemsSource>
                                    </inputs:SfComboBox>
                                </HorizontalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                <Label Text="Item Discounts:" FontSize="13" TextColor="#6C757D" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                    <Label Text="-" TextColor="#FD7E14" FontSize="13"/>
                                    <Label Text="{Binding TotalDiscount, StringFormat='₹ {0:F2}'}" TextColor="#FD7E14" FontSize="13" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                <Label Text="Round Off:" FontSize="13" TextColor="#6C757D" VerticalOptions="Center"/>
                                <Label Text="{Binding RoundOffAmount, StringFormat='₹ {0:F2}'}" FontSize="13" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#DEE2E6" Margin="0,8" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                <Label Text="Grand Total:" FontSize="18" FontAttributes="Bold" TextColor="#212529" VerticalOptions="Center"/>
                                <Label Text="{Binding GrandTotal, StringFormat='₹ {0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="#005A9C" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                <Label Text="Total Paid:" FontSize="14" FontAttributes="Bold" TextColor="#6C757D" VerticalOptions="Center"/>
                                <Label Text="{Binding PaidAmount, StringFormat='₹ {0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="#28A745" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <HorizontalStackLayout HorizontalOptions="End" Spacing="15" Margin="0,5,0,30">
                    <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="15" Margin="0,10,0,30">

                        <Button Text="Cancel Edits" BackgroundColor="#E9ECEF" TextColor="#495057" 
                                Grid.Column="0" WidthRequest="120" HeightRequest="50" FontSize="14" CornerRadius="6" 
                                FontAttributes="Bold" Command="{Binding CancelEditCommand}"/>

                        <Button Text="Save Changes" Grid.Column="1" WidthRequest="150"
                                BackgroundColor="#28A745" TextColor="White" HeightRequest="50" FontSize="14" CornerRadius="6"
                                FontAttributes="Bold" Command="{Binding SaveChangesCommand}"/>

                    </Grid>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ContentView BackgroundColor="#80FFFFFF" IsVisible="{Binding IsBusy}" VerticalOptions="Fill" HorizontalOptions="Fill">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#005A9C" WidthRequest="60" HeightRequest="60"/>
                <Label Text="Processing..." FontAttributes="Bold" TextColor="#005A9C" FontSize="16" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ContentView>
    </Grid>
</ContentPage>