<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             x:Class="Garmetix.AI.Billing.Views.InvoiceHistoryPage"
             Title="Sales &amp; Financial Dashboard"
             BackgroundColor="#F4F6F9">

    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="MetricCard">
            <Setter Property="Padding" Value="20, 15" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#1A000000" Offset="0,4" Radius="12" Opacity="0.4" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Border" x:Key="DashboardSection">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#0D000000" Offset="0,2" Radius="8" Opacity="0.2" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto, Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="15" Padding="20">
                <Border Grid.Column="0" BackgroundColor="#4F46E5" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="TOTAL SALES" FontSize="12" TextColor="#FFFFFF" FontAttributes="Bold" Opacity="0.85" />
                        <Label Text="{Binding TotalSales, StringFormat='₹ {0:N2}'}" FontSize="22" TextColor="#FFFFFF" FontAttributes="Bold" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#10B981" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="RECEIVED" FontSize="12" TextColor="#FFFFFF" FontAttributes="Bold" Opacity="0.85" />
                        <Label Text="{Binding TotalReceived, StringFormat='₹ {0:N2}'}" FontSize="22" TextColor="#FFFFFF" FontAttributes="Bold" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#F43F5E" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="BALANCE DUE" FontSize="12" TextColor="#FFFFFF" FontAttributes="Bold" Opacity="0.85" />
                        <Label Text="{Binding TotalPending, StringFormat='₹ {0:N2}'}" FontSize="22" TextColor="#FFFFFF" FontAttributes="Bold" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="20,0,20,15" Padding="15,10" Style="{StaticResource DashboardSection}">
                <Grid ColumnDefinitions="2*, 1.5*, 1.5*" ColumnSpacing="15">
                    <core:SfTextInputLayout Hint="🔍 Search Customer or Invoice #" ContainerType="Outlined" Grid.Column="0">
                        <Entry Text="{Binding SearchText, Mode=TwoWay}" ClearButtonVisibility="WhileEditing" />
                    </core:SfTextInputLayout>
                    <core:SfTextInputLayout Hint="📅 Date Range" ContainerType="Outlined" Grid.Column="1">
                        <Picker ItemsSource="{Binding DateRanges}" SelectedItem="{Binding SelectedDateRange}" />
                    </core:SfTextInputLayout>
                    <core:SfTextInputLayout Hint="💵 Payment Type" ContainerType="Outlined" Grid.Column="2">
                        <Picker ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedPaymentMode}" />
                    </core:SfTextInputLayout>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="20,0,20,20" Padding="15,10" Style="{StaticResource DashboardSection}">
                <Grid>
                    <sfgrid:SfDataGrid ItemsSource="{Binding FilteredInvoices}"  
                                       SelectedRow="{Binding SelectedInvoice, Mode=TwoWay}"
                                       SelectionMode="Single" 
                                       HeaderGridLinesVisibility="Horizontal"
                                       GridLinesVisibility="Horizontal" 
                                       HeaderRowHeight="55" RowHeight="60" 
                                       AutoGenerateColumnsMode="None">
                        <sfgrid:SfDataGrid.Columns>
                            <sfgrid:DataGridDateColumn MappingName="Date" HeaderText="Date" Format="dd-MMM-yyyy" Width="110"/>
                            <sfgrid:DataGridTextColumn MappingName="InvoiceNo" HeaderText="Invoice No" Width="170"/>
                            <sfgrid:DataGridTextColumn MappingName="CustomerName" HeaderText="Customer Name" />
                            <sfgrid:DataGridNumericColumn MappingName="GrandTotal" HeaderText="Bill Amount" Format="N2" />
                            <sfgrid:DataGridNumericColumn MappingName="BalanceAmount" HeaderText="Balance Due" Format="N2" />
                        </sfgrid:SfDataGrid.Columns>
                    </sfgrid:SfDataGrid>
                </Grid>
            </Border>

            <Button Grid.Row="2" Command="{Binding AddNewInvoiceCommand}"
                    Text="+" FontSize="32" FontAttributes="Bold" TextColor="White"
                    BackgroundColor="#4F46E5" CornerRadius="30"
                    WidthRequest="60" HeightRequest="60"
                    HorizontalOptions="End" VerticalOptions="End" 
                    Margin="0,0,30,40">
                <Button.Shadow>
                    <Shadow Brush="#4F46E5" Offset="0,4" Radius="10" Opacity="0.6" />
                </Button.Shadow>
            </Button>
        </Grid>

        <ContentView BackgroundColor="#99000000" IsVisible="{Binding IsDetailsModalVisible}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">

            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseModalCommand}" />
            </ContentView.GestureRecognizers>

            <Border BackgroundColor="#FFFFFF" WidthRequest="500" HeightRequest="550" 
                    HorizontalOptions="Center" VerticalOptions="Center" 
                    StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="20">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, Auto, *, Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout>
                            <Label Text="INVOICE DETAILS" FontSize="12" FontAttributes="Bold" TextColor="#6C757D" />
                            <Label Text="{Binding ModalInvoiceDetails.InvoiceNo}" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseModalCommand}" 
                                BackgroundColor="Transparent" TextColor="#6C757D" FontSize="20" FontAttributes="Bold" WidthRequest="40" />
                    </Grid>

                    <BoxView Grid.Row="1" HeightRequest="1" Color="#E2E8F0" Margin="0,15" />

                    <CollectionView Grid.Row="2" ItemsSource="{Binding ModalItems}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="3*, 1*, 1.5*" Padding="0,0,0,10">
                                <Label Grid.Column="0" Text="Item" FontAttributes="Bold" TextColor="#868E96" FontSize="13"/>
                                <Label Grid.Column="1" Text="Qty" FontAttributes="Bold" TextColor="#868E96" FontSize="13" HorizontalOptions="End"/>
                                <Label Grid.Column="2" Text="Total" FontAttributes="Bold" TextColor="#868E96" FontSize="13" HorizontalOptions="End"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="3*, 1*, 1.5*" Padding="0,8">
                                    <Label Grid.Column="0" Text="{Binding ProductName}" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50"/>
                                    <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='{0:0.##}'}" FontSize="14" TextColor="#6C757D" HorizontalOptions="End"/>
                                    <Label Grid.Column="2" Text="{Binding TotalAmount, StringFormat='₹ {0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="End"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="3" Spacing="5" Margin="0,15,0,0">
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,0,0,10" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="SubTotal" TextColor="#6C757D" />
                            <Label Grid.Column="1" Text="{Binding ModalInvoiceDetails.SubTotal, StringFormat='₹ {0:N2}'}" FontAttributes="Bold" TextColor="#2C3E50" />
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Discount" TextColor="#6C757D" />
                            <Label Grid.Column="1" Text="{Binding ModalInvoiceDetails.TotalDiscount, StringFormat='- ₹ {0:N2}'}" FontAttributes="Bold" TextColor="#10B981" />
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                            <Label Grid.Column="0" Text="GRAND TOTAL" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="{Binding ModalInvoiceDetails.GrandTotal, StringFormat='₹ {0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#4F46E5" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </ContentView>

        <ContentView BackgroundColor="#66FFFFFF" IsVisible="{Binding IsBusy}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
            <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center" Color="#4F46E5" WidthRequest="60" HeightRequest="60"/>
        </ContentView>
    </Grid>
</ContentPage>