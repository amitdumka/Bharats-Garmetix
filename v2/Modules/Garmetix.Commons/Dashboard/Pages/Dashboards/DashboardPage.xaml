<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="Garmetix.Commons.Dashboard.Pages.Dashboards.DashboardPage"
             Title="Financial Dashboard"
             BackgroundColor="#F4F6F9">

    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="GlassCard">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#0F000000" Offset="0,6" Radius="15" Opacity="0.3" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label" x:Key="MetricTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextTransform" Value="Uppercase" />
        </Style>

        <Style TargetType="Label" x:Key="MetricValue">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout>
                        <Label Text="Overview" FontSize="24" FontAttributes="Bold" TextColor="#1E293B"/>
                        <Label Text="{Binding CurrentDateDisplay}" FontSize="14" TextColor="#64748B" Margin="0,2,0,0"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="↻ Refresh" Command="{Binding RefreshDataCommand}" 
                            BackgroundColor="#E2E8F0" TextColor="#475569" FontAttributes="Bold" CornerRadius="8" HeightRequest="40"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="15">

                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="TODAY'S SALES" Style="{StaticResource MetricTitle}" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#DCFCE7" Padding="6" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label Text="📈" FontSize="14"/>
                                </Border>
                            </Grid>
                            <Label Text="{Binding TodaySales, StringFormat='₹ {0:N0}'}" Style="{StaticResource MetricValue}" TextColor="#10B981"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="MONTH PURCHASES" Style="{StaticResource MetricTitle}" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#F3E8FF" Padding="6" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label Text="📦" FontSize="14"/>
                                </Border>
                            </Grid>
                            <Label Text="{Binding MonthPurchases, StringFormat='₹ {0:N0}'}" Style="{StaticResource MetricValue}" TextColor="#8B5CF6"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="MONTH EXPENSES" Style="{StaticResource MetricTitle}" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#FFE4E6" Padding="6" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label Text="📉" FontSize="14"/>
                                </Border>
                            </Grid>
                            <Label Text="{Binding MonthExpenses, StringFormat='₹ {0:N0}'}" Style="{StaticResource MetricValue}" TextColor="#F43F5E"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="AVAILABLE BANK/CASH" Style="{StaticResource MetricTitle}" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#E0F2FE" Padding="6" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label Text="🏦" FontSize="14"/>
                                </Border>
                            </Grid>
                            <Label Text="{Binding CashBalance, StringFormat='₹ {0:N0}'}" Style="{StaticResource MetricValue}" TextColor="#0EA5E9"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="6*, 4*" ColumnSpacing="20">

                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout>
                            <Label Text="7-Day Cash Flow" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,15"/>

                            <chart:SfCartesianChart HeightRequest="300">
                                <chart:SfCartesianChart.XAxes>
                                    <chart:CategoryAxis ShowMajorGridLines="False" />
                                </chart:SfCartesianChart.XAxes>
                                <chart:SfCartesianChart.YAxes>
                                    <chart:NumericalAxis ShowMajorGridLines="True" EnableAutoIntervalOnZooming="True"/>
                                </chart:SfCartesianChart.YAxes>
                                <chart:SfCartesianChart.Legend>
                                    <chart:ChartLegend Placement="Top" />
                                </chart:SfCartesianChart.Legend>

                                <chart:ColumnSeries ItemsSource="{Binding WeeklyCashFlow}" XBindingPath="Label" YBindingPath="Value1" Label="Inflow (Sales)" Fill="#10B981" CornerRadius="4"/>
                                <chart:ColumnSeries ItemsSource="{Binding WeeklyCashFlow}" XBindingPath="Label" YBindingPath="Value2" Label="Outflow (Purchases)" Fill="#F43F5E" CornerRadius="4"/>
                            </chart:SfCartesianChart>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout>
                            <Label Text="Expense Distribution" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,15"/>

                            <chart:SfCircularChart HeightRequest="300">
                                <chart:SfCircularChart.Legend>
                                    <chart:ChartLegend Placement="Bottom" />
                                </chart:SfCircularChart.Legend>

                                <chart:DoughnutSeries ItemsSource="{Binding ExpenseDistribution}" XBindingPath="Label" YBindingPath="Value1" 
                                                      EnableAnimation="True" InnerRadius="0.6" ShowDataLabels="True">
                                    <chart:DoughnutSeries.DataLabelSettings>
                                        <chart:CircularDataLabelSettings LabelPlacement="Outer"/>
                                    </chart:DoughnutSeries.DataLabelSettings>
                                </chart:DoughnutSeries>
                            </chart:SfCircularChart>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,30">
                    <VerticalStackLayout>
                        <Label Text="Live Ledger Activity" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding RecentTransactions}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,12">
                                        <Border Grid.Column="0" BackgroundColor="{Binding ColorHex}" WidthRequest="12" HeightRequest="12" 
                                                StrokeShape="RoundRectangle 6" StrokeThickness="0" VerticalOptions="Center" Margin="0,0,15,0"/>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Reference}" FontSize="15" FontAttributes="Bold" TextColor="#1E293B"/>
                                            <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
                                                <Label Text="{Binding Type}" FontSize="11" FontAttributes="Bold" TextColor="{Binding ColorHex}" />
                                                <Label Text="•" FontSize="11" TextColor="#CBD5E1"/>
                                                <Label Text="{Binding Time}" FontSize="12" TextColor="#94A3B8"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding Amount, StringFormat='₹ {0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <ContentView BackgroundColor="#80FFFFFF" IsVisible="{Binding IsBusy}" VerticalOptions="Fill" HorizontalOptions="Fill">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#4F46E5" WidthRequest="60" HeightRequest="60" VerticalOptions="Center" HorizontalOptions="Center"/>
        </ContentView>
    </Grid>
</ContentPage>