<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Garmetix.CoreBase.Dashboard.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Garmetix.CoreBase.Dashboard.Pages.Controls"
    xmlns:models="clr-namespace:Garmetix.Core.VM.Dashboards;assembly=Garmetix.Core"
    xmlns:pageModel="clr-namespace:Garmetix.Commons.Dashboard.PageModels"
    xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    x:Name="CPage"
    Title="Dashboard"
    x:DataType="pageModel:DefaultDashboardPageModel"
    Style="{StaticResource PageBackgroundStyle}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding BindingContext, x:DataType=ContentPage, Source={Reference CPage}}"
            Command="{Binding AppearingCommand}"
            EventName="Appearing" />
    </ContentPage.Behaviors>

    <Grid>
        <pullToRefresh:SfPullToRefresh IsRefreshing="{Binding IsRefreshing}" RefreshCommand="{Binding RefreshCommand}">
            <pullToRefresh:SfPullToRefresh.PullableContent>
                <ScrollView>
                    <Grid
                        Padding="10"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,*,Auto">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,10"
                            Style="{StaticResource DashboardHeaderLabel}"
                            Text="Dashboard" />

                        <Grid
                            x:Name="LeftGrid"
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="10"
                            RowDefinitions="Auto,Auto,Auto,Auto">
                            <Border Grid.RowSpan="4" Style="{StaticResource DashboardCardBorder}">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Style="{StaticResource FinancialOverviewLabel}"
                                        Text="{Binding FinancialInfo.TotalReceivable, StringFormat='Receivable: {0:C}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource ReceivableColor},
                                                                    Dark={StaticResource ReceivableColor}}" />
                                    <VerticalStackLayout Grid.Row="1" Margin="0,10,0,0">
                                        <Label Style="{StaticResource FinancialSubCategoryHeader}" Text="Today's" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.TodaysRecipets, StringFormat='Receipts: {0:C}'}" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.TodaysSales, StringFormat='Sales: {0:C}'}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Margin="0,10,0,0">
                                        <Label Style="{StaticResource FinancialSubCategoryHeader}" Text="Monthly's" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.MonthlyRecipets, StringFormat='Receipts: {0:C}'}" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.MonthlySales, StringFormat='Sales: {0:C}'}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="3" Margin="0,10,0,0">
                                        <Label Style="{StaticResource FinancialSubCategoryHeader}" Text="Yearly's" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.TotalRecipets, StringFormat='Receipts: {0:C}'}" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.TotalSales, StringFormat='Sales: {0:C}'}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid
                            x:Name="RightGrid"
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="10"
                            RowDefinitions="Auto,Auto,Auto,Auto">
                            <Border Grid.RowSpan="4" Style="{StaticResource DashboardCardBorder}">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Style="{StaticResource FinancialOverviewLabel}"
                                        Text="{Binding FinancialInfo.TotalPayable, StringFormat='Payables: {0:C}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource PayableColor},
                                                                    Dark={StaticResource PayableColor}}" />
                                    <VerticalStackLayout Grid.Row="1" Margin="0,10,0,0">
                                        <Label Style="{StaticResource FinancialSubCategoryHeader}" Text="Today's" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.TodaysExpense, StringFormat='Expenses: {0:C}'}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Margin="0,10,0,0">
                                        <Label Style="{StaticResource FinancialSubCategoryHeader}" Text="Monthly's" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.MonthlyExpense, StringFormat='Expenses: {0:C}'}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="3" Margin="0,10,0,0">
                                        <Label Style="{StaticResource FinancialSubCategoryHeader}" Text="Yearly's" />
                                        <Label Style="{StaticResource FinancialValueDisplay}" Text="{Binding FinancialInfo.TotalExpense, StringFormat='Expenses: {0:C}'}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>

                        <VerticalStackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,20,0,0">
                            <Label
                                Margin="10,0,0,10"
                                Style="{StaticResource Title2}"
                                Text="Employee's"
                                TextColor="{AppThemeBinding Light={StaticResource HeaderTextColor},
                                                            Dark={StaticResource HeaderTextColor}}" />
                            <ScrollView Orientation="Horizontal">
                                <HorizontalStackLayout
                                    Padding="10,0"
                                    BindableLayout.ItemsSource="{Binding PayrollInfo.EmployeeList}"
                                    Spacing="15">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:EmployeeInfo">
                                            <controls:EmployeeCardView WidthRequest="200">
                                                <controls:EmployeeCardView.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding NavigateToEmployeeCommand, Source={RelativeSource AncestorType={x:Type pageModel:DefaultDashboardPageModel}}}" CommandParameter="{Binding .}" />
                                                </controls:EmployeeCardView.GestureRecognizers>
                                            </controls:EmployeeCardView>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                    </Grid>
                </ScrollView>
            </pullToRefresh:SfPullToRefresh.PullableContent>
        </pullToRefresh:SfPullToRefresh>
    </Grid>
</ContentPage>