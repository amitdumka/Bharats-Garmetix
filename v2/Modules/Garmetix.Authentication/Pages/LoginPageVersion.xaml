<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.Authentication.Pages.LoginPageVersion"
             Title="LoginPageVersion"

             BackgroundColor="#F8F9FE"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="350, *" RowSpacing="0">

            <Image Grid.Row="0"
                   Source="header_background.png"
                   Aspect="AspectFill"
                   VerticalOptions="Fill"
                   HorizontalOptions="Fill" />

            <Border Grid.Row="0"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,40,20,0"
                    Stroke="Transparent"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="40"
                    Padding="15,0">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Image Source="globe_icon.png" WidthRequest="18" HeightRequest="18" />
                    <Label Text="English" TextColor="#1E293B" VerticalOptions="Center" FontFamily="OpenSansRegular" />
                    <Image Source="chevron_down.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="1"
                                 Padding="25,20,25,30"
                                 Spacing="15"
                                 BackgroundColor="#F8F9FE">

                <Label Margin="0,0,0,5">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Welcome " TextColor="#111827" FontFamily="OpenSansSemibold" FontSize="32" />
                            <Span Text="Back!" TextColor="#6C2BD9" FontFamily="OpenSansSemibold" FontSize="32" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Text="Sign in to continue to Garmetix"
                       TextColor="#6B7280"
                       FontSize="15"
                       Margin="0,0,0,15"
                       FontFamily="OpenSansRegular" />

                <Border Stroke="#F3F4F6"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="60"
                        Padding="15,0">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                        <Image Source="user_icon.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="Username / Email"
                               PlaceholderColor="#9CA3AF"
                               TextColor="#111827"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Stroke="#F3F4F6"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="60"
                        Padding="15,0">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                        <Image Source="lock_icon.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />

                        <Entry x:Name="PasswordEntry"
                               Grid.Column="1"
                               Placeholder="Password"
                               IsPassword="True"
                               PlaceholderColor="#9CA3AF"
                               TextColor="#111827"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />

                        <Image Grid.Column="2"
                               Source="eye_icon.png"
                               WidthRequest="22"
                               HeightRequest="22"
                               VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEyeIconTapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,15">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="RememberMeCheckBox" Color="#6C2BD9" WidthRequest="24" HeightRequest="24" />
                        <Label Text="Remember me" TextColor="#4B5563" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Grid.Column="2"
                           Text="Forgot Password?"
                           TextColor="#6C2BD9"
                           FontFamily="OpenSansSemibold"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Button Text="Login"
                        ImageSource="arrow_right.png"
                        ContentLayout="Right, 20"
                        BackgroundColor="#6C2BD9"
                        TextColor="White"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        CornerRadius="16"
                        HeightRequest="60"
                        Clicked="OnLoginClicked"
                        Margin="0,0,0,15" />

                <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="15" Margin="0,10">
                    <BoxView Grid.Column="0" HeightRequest="1" Color="#E5E7EB" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="or login with" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center" />
                    <BoxView Grid.Column="2" HeightRequest="1" Color="#E5E7EB" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15" Margin="0,10,0,20">
                    <Border Grid.Column="0" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" HeightRequest="60">
                        <Image Source="google_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" />
                    </Border>
                    <Border Grid.Column="1" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" HeightRequest="60">
                        <Image Source="microsoft_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" />
                    </Border>
                    <Border Grid.Column="2" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" HeightRequest="60">
                        <Image Source="apple_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" />
                    </Border>
                </Grid>

                <Border Stroke="#F3F4F6"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="70"
                        Padding="15,0"
                        Margin="0,0,0,20">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" VerticalOptions="Center">
                        <Image Grid.Column="0" Source="shield_check.png" WidthRequest="40" HeightRequest="40" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Your data is 100% secure" TextColor="#111827" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="We keep your business safe and secure" TextColor="#9CA3AF" FontSize="12" />
                        </VerticalStackLayout>

                        <Image Grid.Column="2" Source="chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label Text="Version 1.0.0"
                       TextColor="#9CA3AF"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Margin="0,0,0,20" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>