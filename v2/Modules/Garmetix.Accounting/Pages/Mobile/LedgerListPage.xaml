<?xml version="1.0" encoding="utf-8" ?>
<listing:BaseListViewPage
    x:Class="Garmetix.Accounting.Pages.Mobile.LedgerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:listing="clr-namespace:Garmetix.Base.Views.Customs.Listing;assembly=Garmetix.Base"
    xmlns:models="clr-namespace:Garmetix.Models.Accounting;assembly=Garmetix.Models">
    <listing:BaseListViewPage.ListItemTemplate>
        <DataTemplate x:DataType="models:Ledger">
            <Border
                Margin="12,6"
                Padding="0"
                Stroke="{AppThemeBinding Light={StaticResource Gray300},
                                         Dark={StaticResource Gray700}}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <Grid
                    Padding="12"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="Medium"
                            Text="{Binding Name}" />
                        <VerticalStackLayout>
                            <Label
                                FontSize="Small"
                                Text="{Binding OpenningBalance, StringFormat='Opening: {0}'}"
                                TextColor="{DynamicResource Dull-Red}" />
                            <Label
                                FontSize="Small"
                                Text="{Binding LedgerGroup.Name, StringFormat='Group: {0}'}"
                                TextColor="{DynamicResource SecondaryDarkText}" />

                        </VerticalStackLayout>
                        <Label FontSize="Small" Text="{Binding LedgerType, StringFormat='Type: {0}'}" />

                    </VerticalStackLayout>
                    <Image
                        Grid.Column="1"
                        HeightRequest="16"
                        Source="righticon.png"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </listing:BaseListViewPage.ListItemTemplate>


</listing:BaseListViewPage>