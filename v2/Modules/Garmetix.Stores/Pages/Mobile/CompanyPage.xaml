<?xml version="1.0" encoding="utf-8" ?>
<listing:BaseListViewPage
    x:Class="Garmetix.CoreBase.Stores.Pages.Mobile.CompanyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:listing="clr-namespace:Garmetix.Base.Views.Customs.Listing;assembly=Garmetix.Base"
    xmlns:models="clr-namespace:Garmetix.Models.Stores;assembly=Garmetix.Models"
    xmlns:vm="clr-namespace:Garmetix.CoreBase.Stores.PageModels"
    x:Name="storePage">
    <listing:BaseListViewPage.ListItemTemplate>
        <DataTemplate x:DataType="models:Company">
            <Border
                Margin="12,6"
                Padding="0"
                Stroke="{AppThemeBinding Light={StaticResource Gray300},
                                         Dark={StaticResource Gray700}}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <Grid
                    Padding="12"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="Medium"
                            Text="{Binding Name}" />
                        <VerticalStackLayout Margin="4" Padding="5">
                            <Label
                                FontSize="Small"
                                Text="{Binding GSTIN, StringFormat='GSTIN: {0}'}"
                                TextColor="{StaticResource Secondary}" />
                            <Label
                                FontSize="Small"
                                Text="{Binding Pan, StringFormat='Pan: {0}'}"
                                TextColor="{StaticResource SecondaryDarkText}" />
                            <Label
                                FontSize="Small"
                                Text="{Binding Code, StringFormat='Code: {0}'}"
                                TextColor="{StaticResource Secondary}" />
                            <Label
                                FontSize="Small"
                                Text="{Binding Address, StringFormat='Address: {0}'}"
                                TextColor="{StaticResource SecondaryDarkText}" />

                        </VerticalStackLayout>
                        <Label FontSize="Small" Text="{Binding StoreCategory, StringFormat='Category: {0}'}" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="1"
                        HeightRequest="16"
                        Source="righticon.png"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </listing:BaseListViewPage.ListItemTemplate>


</listing:BaseListViewPage>