<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             x:Class="Garmetix.AI.Billing.Views.PartyRegistryPage"
             Title="Parties &amp; Ledgers" BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Margin="20,20,20,10" BackgroundColor="White" Padding="15,5" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <core:SfTextInputLayout Hint="🔍 Search by Name or Phone" ContainerType="Outlined">
                <Entry Text="{Binding SearchText, Mode=TwoWay}" ClearButtonVisibility="WhileEditing" />
            </core:SfTextInputLayout>
        </Border>

        <Border Grid.Row="1" Margin="20,10,20,20" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <Grid>
                <sfgrid:SfDataGrid ItemsSource="{Binding FilteredParties}" AllowGrouping="True" AutoGenerateColumnsMode="None" HeaderRowHeight="50" RowHeight="55">

                    <sfgrid:SfDataGrid.GroupColumnDescriptions>
                        <sfgrid:GroupColumnDescription ColumnName="Category" />
                    </sfgrid:SfDataGrid.GroupColumnDescriptions>

                    <sfgrid:SfDataGrid.Columns>
                        <sfgrid:DataGridTextColumn MappingName="Name" HeaderText="Party Name" Width="200"  />
                        <sfgrid:DataGridTextColumn MappingName="Phone" HeaderText="Contact Number" />
                        <sfgrid:DataGridTextColumn MappingName="GSTIN" HeaderText="GSTIN" />
                        <sfgrid:DataGridTextColumn MappingName="Category" Visible="False" />

                        <sfgrid:DataGridTemplateColumn HeaderText="Actions" Width="100">
                            <sfgrid:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Text="⋮ Edit" BackgroundColor="#E2E8F0" TextColor="#1E293B" CornerRadius="6" HeightRequest="35"
                                            Command="{Binding BindingContext.ActionMenuCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"/>
                                </DataTemplate>
                            </sfgrid:DataGridTemplateColumn.CellTemplate>
                        </sfgrid:DataGridTemplateColumn>
                    </sfgrid:SfDataGrid.Columns>
                </sfgrid:SfDataGrid>
            </Grid>
        </Border>

        <Button Grid.Row="1" Command="{Binding AddNewPartyCommand}" Text="+" FontSize="32" FontAttributes="Bold" TextColor="White"
                BackgroundColor="#10B981" CornerRadius="30" WidthRequest="60" HeightRequest="60" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,30,40">
            <Button.Shadow>
                <Shadow Brush="#10B981" Offset="0,4" Radius="10" Opacity="0.6" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>