<?xml version="1.0" encoding="utf-8" ?>
<FlyoutItem xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.Billing.AiSystems.Views.BankMenu"
               xmlns:views="clr-namespace:Garmetix.AI.Billing.Views"
             Title="BankMenu">
    <Tab Title="Voucher Registry" Route="VoucherRegistryPage">
        <ShellContent ContentTemplate="{DataTemplate views:VoucherRegistryPage}" />
    </Tab>
    <Tab Title="Parties &amp; Ledgers" Route="PartyRegistryPage">
        <ShellContent ContentTemplate="{DataTemplate views:PartyRegistryPage}" />
    </Tab>
    <Tab     Title="Banking Vault" Route="BankRegistryPage">
        <ShellContent ContentTemplate="{DataTemplate views:BankRegistryPage}" />
    </Tab>

</FlyoutItem>