<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Garmetix.AI.Billing.Views.PartyFormPage"
             Title="{Binding PageTitle}" BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Border BackgroundColor="White" Padding="25" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="Company / Person Details" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,10"/>
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="Party Name" ContainerType="Outlined" Grid.Column="0">
                            <Entry Text="{Binding CurrentParty.Name}" FontAttributes="Bold"/>
                        </core:SfTextInputLayout>
                        
                        <core:SfTextInputLayout Hint="Party Category" ContainerType="Outlined" Grid.Column="1">
                            <inputs:SfComboBox ItemsSource="{Binding PartyTypes}" SelectedItem="{Binding CurrentParty.Category}" />
                        </core:SfTextInputLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="Mobile / Phone" ContainerType="Outlined" Grid.Column="0">
                            <Entry Text="{Binding CurrentParty.Phone}" Keyboard="Telephone"/>
                        </core:SfTextInputLayout>
                        
                        <core:SfTextInputLayout Hint="Email Address" ContainerType="Outlined" Grid.Column="1">
                            <Entry Text="{Binding CurrentParty.EmailId}" Keyboard="Email"/>
                        </core:SfTextInputLayout>
                    </Grid>

                    <Label Text="Tax &amp; Address Details" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,15,0,10"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="GSTIN" ContainerType="Outlined" Grid.Column="0">
                            <Entry Text="{Binding CurrentParty.GSTIN}" TextTransform="Uppercase"/>
                        </core:SfTextInputLayout>
                        
                        <core:SfTextInputLayout Hint="PAN Number" ContainerType="Outlined" Grid.Column="1">
                            <Entry Text="{Binding CurrentParty.PAN}" TextTransform="Uppercase"/>
                        </core:SfTextInputLayout>
                    </Grid>

                    <core:SfTextInputLayout Hint="Full Billing Address" ContainerType="Outlined">
                        <Editor Text="{Binding CurrentParty.Address}" HeightRequest="80"/>
                    </core:SfTextInputLayout>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="15" Margin="0,10,0,30">
                <Button Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="#E2E8F0" TextColor="#475569" WidthRequest="120" HeightRequest="50" FontAttributes="Bold"/>
                <Button Text="Save Ledger" Command="{Binding SaveCommand}" BackgroundColor="#10B981" TextColor="White" WidthRequest="180" HeightRequest="50" FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>