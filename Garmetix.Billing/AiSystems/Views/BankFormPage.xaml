<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Garmetix.AI.Billing.Views.BankFormPage"
             Title="{Binding PageTitle}" BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Border BackgroundColor="White" Padding="25" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Core Account Details" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,10"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="Bank Name (e.g. HDFC, SBI)" ContainerType="Outlined" Grid.Column="0">
                            <Entry Text="{Binding BankNameInput}" FontAttributes="Bold" />
                        </core:SfTextInputLayout>

                        <core:SfTextInputLayout Hint="Account Type" ContainerType="Outlined" Grid.Column="1">
                            <inputs:SfComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding CurrentAccount.AccountType}" />
                        </core:SfTextInputLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="Account Number" ContainerType="Outlined" Grid.Column="0">
                            <Entry Text="{Binding CurrentAccount.AccountNumber}" Keyboard="Numeric" FontAttributes="Bold" TextColor="#0EA5E9"/>
                        </core:SfTextInputLayout>

                        <core:SfTextInputLayout Hint="IFSC Code" ContainerType="Outlined" Grid.Column="1">
                            <Entry Text="{Binding CurrentAccount.IFSCode}" TextTransform="Uppercase"/>
                        </core:SfTextInputLayout>
                    </Grid>

                    <core:SfTextInputLayout Hint="Account Holder Name (As per Bank)" ContainerType="Outlined">
                        <Entry Text="{Binding CurrentAccount.AccountHolderName}" TextTransform="Uppercase"/>
                    </core:SfTextInputLayout>

                    <Label Text="Branch &amp; Balances" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,15,0,10"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="Branch Name" ContainerType="Outlined" Grid.Column="0">
                            <Entry Text="{Binding CurrentAccount.Branch}"/>
                        </core:SfTextInputLayout>

                        <core:SfTextInputLayout Hint="Opening Balance (₹)" ContainerType="Outlined" Grid.Column="1">
                            <Entry Text="{Binding CurrentAccount.OpeningBalance}" Keyboard="Numeric"/>
                        </core:SfTextInputLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="15" Margin="0,10,0,30">
                <Button Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="#E2E8F0" TextColor="#475569" WidthRequest="120" HeightRequest="50" FontAttributes="Bold"/>
                <Button Text="Save Account" Command="{Binding SaveCommand}" BackgroundColor="#0EA5E9" TextColor="White" WidthRequest="180" HeightRequest="50" FontAttributes="Bold">
                    <Button.Shadow>
                        <Shadow Brush="#0EA5E9" Offset="0,4" Radius="8" Opacity="0.4" />
                    </Button.Shadow>
                </Button>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>