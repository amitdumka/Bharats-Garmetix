<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             x:Class="Garmetix.AI.Billing.Views.VoucherRegistryPage"
             Title="Accounting Vouchers" BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Margin="20,20,20,10" BackgroundColor="White" Padding="15,5" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <core:SfTextInputLayout Hint="🔍 Search Voucher No or Party" ContainerType="Outlined">
                <Entry Text="{Binding SearchText, Mode=TwoWay}" ClearButtonVisibility="WhileEditing" />
            </core:SfTextInputLayout>
        </Border>

        <Border Grid.Row="1" Margin="20,10,20,20" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <Grid>
                <sfgrid:SfDataGrid ItemsSource="{Binding FilteredVouchers}" AllowGrouping="True" AutoGenerateColumnsMode="None" HeaderRowHeight="50" RowHeight="55">
                    
                    <sfgrid:SfDataGrid.GroupColumnDescriptions>
                        <sfgrid:GroupColumnDescription ColumnName="VoucherType" />
                    </sfgrid:SfDataGrid.GroupColumnDescriptions>

                    <sfgrid:SfDataGrid.Columns>
                        <sfgrid:DataGridDateColumn MappingName="OnDate" HeaderText="Date" Format="dd-MMM-yyyy" Width="120"/>
                        <sfgrid:DataGridTextColumn MappingName="VoucherNumber" HeaderText="Voucher No" Width="150" FontAttributes="Bold"/>
                        <sfgrid:DataGridTextColumn MappingName="PartyName" HeaderText="Party / Ledger" />
                        <sfgrid:DataGridTextColumn MappingName="PaymentMode" HeaderText="Mode" Width="120"/>
                        <sfgrid:DataGridNumericColumn MappingName="Amount" HeaderText="Amount" Format="N2" />
                        
                        <sfgrid:DataGridTemplateColumn HeaderText="Actions" Width="100">
                            <sfgrid:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Text="⋮ Options" BackgroundColor="#E2E8F0" TextColor="#1E293B" CornerRadius="6" HeightRequest="35"
                                            Command="{Binding BindingContext.ActionMenuCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"/>
                                </DataTemplate>
                            </sfgrid:DataGridTemplateColumn.CellTemplate>
                        </sfgrid:DataGridTemplateColumn>
                    </sfgrid:SfDataGrid.Columns>

                    <sfgrid:SfDataGrid.GroupSummaryRows>
                        <sfgrid:DataGridSummaryRow Title="{Key} Totals: {Amount}" ShowSummaryInRow="True">
                            <sfgrid:DataGridSummaryRow.SummaryColumns>
                                <sfgrid:DataGridSummaryColumn Name="Amount" Format="'₹ {Sum:N2}'" MappingName="Amount" SummaryType="Sum" />
                            </sfgrid:DataGridSummaryRow.SummaryColumns>
                        </sfgrid:DataGridSummaryRow>
                    </sfgrid:SfDataGrid.GroupSummaryRows>
                </sfgrid:SfDataGrid>
            </Grid>
        </Border>

        <Button Grid.Row="1" Command="{Binding AddNewVoucherCommand}" Text="+" FontSize="32" FontAttributes="Bold" TextColor="White"
                BackgroundColor="#4F46E5" CornerRadius="30" WidthRequest="60" HeightRequest="60" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,30,40">
            <Button.Shadow><Shadow Brush="#4F46E5" Offset="0,4" Radius="10" Opacity="0.6" /></Button.Shadow>
        </Button>
    </Grid>
</ContentPage>