<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             x:Class="Garmetix.AI.Billing.Views.InvoiceEntryPage"
             Title="Point of Sale">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <Border Padding="10" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Customer Details" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*, *, *, Auto" RowSpacing="10" ColumnSpacing="10">

                        <core:SfTextInputLayout Hint="Mobile Number" Grid.Column="0">
                            <Entry Text="{Binding CurrentInvoice.MobileNo}" Keyboard="Numeric" MaxLength="10" Unfocused="MobileNoEntry_Unfocused"/>
                        </core:SfTextInputLayout>

                        <core:SfTextInputLayout Hint="Customer Name" Grid.Column="1">
                            <Entry Text="{Binding CurrentInvoice.CustomerName}" />
                        </core:SfTextInputLayout>

                        <core:SfTextInputLayout Hint="GSTIN (Optional)" Grid.Column="2">
                            <Entry Text="{Binding CurrentInvoice.Gstin}" />
                        </core:SfTextInputLayout>

                        <Button Text="Save New" Command="{Binding SaveCustomerCommand}" IsVisible="{Binding IsNewCustomer}" 
                    Grid.Column="3" HeightRequest="45" VerticalOptions="Center" BackgroundColor="#28a745" TextColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <inputs:SfAutocomplete 
                    WidthRequest="300" ToolTipProperties.Text="Scan Barcode or Type Name..." Placeholder="Scan Barcode or Type Name..."
                    ItemsSource="{Binding AvailableProducts}" DisplayMemberPath="Name" TextMemberPath="Barcode"
                    SelectedItem="{Binding SelectedProduct}"/>
                <Button Text="Add Item" Command="{Binding AddProductToInvoiceCommand}" />
            </HorizontalStackLayout>

            <datagrid:SfDataGrid AllowSelectionOnSecondaryTap="True" ShowToolTip="True" 
                     AllowEditing="True" SelectionMode="Single" NavigationMode="Cell"
                                 
                                 SelectedRow="{Binding SelectedInvoiceItem}"
                     AutoGenerateColumnsMode="None" HeightRequest="250" 
                     ItemsSource="{Binding InvoiceItems}" ColumnWidthMode="Fill">
                <datagrid:SfDataGrid.Columns>
                    <datagrid:DataGridTextColumn MappingName="ProductName" HeaderText="Item Name" Width="150" AllowEditing="False"/>
                    <datagrid:DataGridNumericColumn MappingName="Rate" HeaderText="Rate" Format="N2" AllowEditing="True"/>
                    <datagrid:DataGridNumericColumn MappingName="Quantity" HeaderText="Qty" AllowEditing="True"/>
                    <datagrid:DataGridNumericColumn MappingName="DiscountAmount" HeaderText="Disc." Format="N2" AllowEditing="True"/>

                    <datagrid:DataGridNumericColumn MappingName="GstPercentage" HeaderText="GST %" Format="N0" AllowEditing="False"/>

                    <datagrid:DataGridTemplateColumn MappingName="Id" HeaderText="Action" Width="80">
                        <datagrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Text="X" BackgroundColor="Red" TextColor="White" Padding="0" 
                            Command="{Binding BindingContext.RemoveInvoiceItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                            CommandParameter="{Binding .}" HeightRequest="30" WidthRequest="30" CornerRadius="15"/>
                            </DataTemplate>
                        </datagrid:DataGridTemplateColumn.CellTemplate>
                    </datagrid:DataGridTemplateColumn>
                </datagrid:SfDataGrid.Columns>
            </datagrid:SfDataGrid>

            <Border Padding="10" StrokeShape="RoundRectangle 5" Background="#F8F9FA">
                <Grid ColumnDefinitions="6*, 4*" ColumnSpacing="10">

                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Payments" FontAttributes="Bold" FontSize="14" />

                        <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="5">
                            <inputs:SfComboBox Grid.Column="0" SelectedItem="{Binding PaymentModeInput}" HeightRequest="35">
                                <inputs:SfComboBox.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Cash</x:String>
                                        <x:String>UPI</x:String>
                                        <x:String>Card</x:String>
                                    </x:Array>
                                </inputs:SfComboBox.ItemsSource>
                            </inputs:SfComboBox>
                            <Entry Grid.Column="1" Placeholder="Amount" Text="{Binding PaymentAmountInput}" Keyboard="Numeric" HeightRequest="35"/>
                            <Button Grid.Column="2" Text="Add" Command="{Binding AddPaymentCommand}" HeightRequest="35" Padding="8,0" FontSize="12"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding Payments}" HeightRequest="75">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, *, Auto" Padding="0,2">
                                        <Label Text="{Binding Mode}" Grid.Column="0" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding Amount, StringFormat='Rs. {0:F2}'}" Grid.Column="1" FontSize="12" VerticalOptions="Center" FontAttributes="Bold"/>

                                        <Button Text="X" Grid.Column="2" WidthRequest="24" HeightRequest="24" Padding="0"
                                    BackgroundColor="Red" TextColor="White" CornerRadius="12" FontSize="10" FontAttributes="Bold"
                                    Command="{Binding BindingContext.RemovePaymentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <BoxView HeightRequest="1" Color="LightGray" />
                        <Label Text="{Binding CurrentInvoice.BalanceAmount, StringFormat='Balance: Rs. {0:F2}'}" TextColor="Red" FontAttributes="Bold" FontSize="14"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="End">
                        <Label Text="{Binding CurrentInvoice.SubTotal, StringFormat='Sub Total: {0:F2}'}" FontSize="12" HorizontalOptions="End"/>
                        <Label Text="{Binding CurrentInvoice.TotalTax, StringFormat='GST: {0:F2}'}" FontSize="12" HorizontalOptions="End"/>
                        <Label Text="{Binding CurrentInvoice.TotalDiscount, StringFormat='Disc: -{0:F2}'}" TextColor="DarkOrange" FontSize="12" HorizontalOptions="End"/>
                        <Label Text="{Binding CurrentInvoice.RoundOffAmount, StringFormat='Round: {0:F2}'}" FontSize="12" HorizontalOptions="End"/>

                        <BoxView HeightRequest="1" Color="Gray" Margin="0,2" />

                        <Label Text="{Binding CurrentInvoice.GrandTotal, StringFormat='Total: Rs. {0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="Black" HorizontalOptions="End"/>
                        <Label Text="{Binding CurrentInvoice.PaidAmount, StringFormat='Paid: Rs. {0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="Green" HorizontalOptions="End"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button Text="Save &amp; Print Receipt" BackgroundColor="#0052cc" TextColor="White" HeightRequest="50" Command="{Binding SaveInvoiceCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>