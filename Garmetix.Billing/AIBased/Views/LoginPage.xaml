<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Garmetix.AI.Billing.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A">

    <Grid>
        <Ellipse Fill="#38BDF8" WidthRequest="400" HeightRequest="400" HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-150" TranslationY="-150" Opacity="0.1"/>
        <Ellipse Fill="#818CF8" WidthRequest="500" HeightRequest="500" HorizontalOptions="End" VerticalOptions="End" TranslationX="200" TranslationY="200" Opacity="0.1"/>

        <Border BackgroundColor="#FFFFFF" WidthRequest="450" HorizontalOptions="Center" VerticalOptions="Center" 
                StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="40"
                Shadow="{Shadow Brush=#000000, Offset='0,10', Radius=30, Opacity=0.2}">

            <VerticalStackLayout Spacing="25">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,0,0,20">
                    <Label Text="GARMETIX" FontSize="28" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" CharacterSpacing="2"/>
                    <Label Text="RETAIL INTELLIGENCE POS" FontSize="12" TextColor="#64748B" HorizontalOptions="Center" FontAttributes="Bold" CharacterSpacing="1"/>
                </VerticalStackLayout>

                <core:SfTextInputLayout Hint="Username" ContainerType="Outlined" OutlineCornerRadius="8">
                    <Entry Text="{Binding Username}" ClearButtonVisibility="WhileEditing" HeightRequest="45"/>
                </core:SfTextInputLayout>

                <core:SfTextInputLayout Hint="Password" ContainerType="Outlined" OutlineCornerRadius="8">
                    <Entry Text="{Binding Password}" IsPassword="True" HeightRequest="45"/>
                </core:SfTextInputLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="#EF4444" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"/>

                <Button Text="SIGN IN" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#4F46E5" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,10,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#4F46E5" Offset="0,4" Radius="10" Opacity="0.4" />
                    </Button.Shadow>
                </Button>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4F46E5" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>