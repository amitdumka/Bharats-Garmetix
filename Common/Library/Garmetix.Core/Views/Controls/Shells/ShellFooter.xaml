<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Garmetix.Views.Controls.ShellFooter"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Garmetix.Views.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Name="shellFooter">
    <StackLayout>
        <Label
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Text="{Binding StoreName, FallbackValue='Store Name: AF'}"
            TextColor="{AppThemeBinding Dark={DynamicResource White},
                                        Light={DynamicResource Black}}" />
        <Label
            HorizontalOptions="Center"
            Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{0:MMMM dd, yyyy}'}"
            TextColor="{AppThemeBinding Dark={DynamicResource White},
                                        Light={DynamicResource Black}}" />
    </StackLayout>
</ContentView>
