<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Garmetix.Authentication.Pages.Login"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:beh="clr-namespace:Garmetix.Authentication.Behavior"
    xmlns:button="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:checkBox="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
    xmlns:local="clr-namespace:Garmetix.Authentication.PageModels"
    Title="Login"
    x:DataType="local:LoginPageViewModel">

    <ContentPage.BindingContext>
        <local:LoginPageViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <ScrollView
            HorizontalOptions="Center"
            VerticalOptions="Center"
            VerticalScrollBarVisibility="Never">
            <Grid
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                VerticalOptions="Center"
                WidthRequest="{OnPlatform WinUI=386,
                                          MacCatalyst=400}">
                <Label
                    Grid.Row="0"
                    Padding="0,0,0,20"
                    FontFamily="Roboto-Medium"
                    FontSize="Medium"
                    HorizontalOptions="Center"
                    Text="Log In"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                Dark={DynamicResource PrimaryColorDark}}" />
                <Label
                    Grid.Row="1"
                    Padding="0,0,0,20"
                    FontFamily="Roboto-Regular"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Aadwika Fashion"
                    TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                Dark={DynamicResource SecondaryTextColorDark}}" />
                <dataForm:SfDataForm
                    x:Name="logInForm"
                    Grid.Row="2"
                    CommitMode="PropertyChanged"
                    DataObject="{Binding LoginInfo}"
                    LayoutType="TextInputLayout"
                    MinimumHeightRequest="{OnPlatform WinUI=170,
                                                      Android=180,
                                                      MacCatalyst=170,
                                                      iOS=170}"
                    ValidationMode="PropertyChanged">
                    <dataForm:SfDataForm.TextInputLayoutSettings>
                        <dataForm:TextInputLayoutSettings OutlineCornerRadius="5" ShowHelperText="True">
                            <dataForm:TextInputLayoutSettings.HelperTextStyle>
                                <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                            </dataForm:TextInputLayoutSettings.HelperTextStyle>
                        </dataForm:TextInputLayoutSettings>
                    </dataForm:SfDataForm.TextInputLayoutSettings>
                    <dataForm:SfDataForm.ErrorLabelTextStyle>
                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                    </dataForm:SfDataForm.ErrorLabelTextStyle>
                    <dataForm:SfDataForm.LabelTextStyle>
                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}" />
                    </dataForm:SfDataForm.LabelTextStyle>
                    <dataForm:SfDataForm.EditorTextStyle>
                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />
                    </dataForm:SfDataForm.EditorTextStyle>
                </dataForm:SfDataForm>

                <Grid Grid.Row="3">
                    <checkBox:SfCheckBox
                        Margin="20,0,20,0"
                        CheckedColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                       Dark={DynamicResource PrimaryColorDark}}"
                        FontFamily="Roboto-Medium"
                        FontSize="14"
                        HorizontalOptions="Start"
                        IsChecked="{Binding LoginInfo.RememberMe, Mode=TwoWay}"
                        Text="Remember me"
                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                    Dark={DynamicResource SecondaryTextColorDark}}"
                        TickColor="{DynamicResource White}" />
                    <button:SfButton
                        Margin="0,0,20,0"
                        Background="Transparent"
                        FontFamily="Roboto-Regular"
                        FontSize="12"
                        HeightRequest="20"
                        HorizontalOptions="End"
                        Text="FORGET PASSWORD?"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                    Dark={DynamicResource PrimaryColorDark}}"
                        WidthRequest="130" />
                </Grid>

                <button:SfButton
                    x:Name="saveButton"
                    Grid.Row="4"
                    Margin="20"
                    HorizontalOptions="Fill"
                    Style="{DynamicResource FormsButtonStyle}"
                    Text="LOG IN" />
                <Label
                    Grid.Row="5"
                    Margin="10"
                    FontFamily="Roboto-Regular"
                    FontSize="12"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="False"
                    Text="Or login with"
                    TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                Dark={DynamicResource SecondaryTextColorDark}}" />
                <Grid Grid.Row="6" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".5*" />
                        <ColumnDefinition Width=".5*" />
                    </Grid.ColumnDefinitions>
                    <button:SfButton
                        Grid.Column="0"
                        Margin="10"
                        Background="Transparent"
                        FontFamily="Roboto-Regular"
                        HorizontalOptions="End"
                        ImageAlignment="Start"
                        ImageSource="google.png"
                        ShowIcon="True"
                        Stroke="#E5E1E3"
                        StrokeThickness="1"
                        Text="Google"
                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                    Dark={DynamicResource SecondaryTextColorDark}}"
                        WidthRequest="150" />
                    <button:SfButton
                        Grid.Column="1"
                        Margin="10"
                        Background="Transparent"
                        FontFamily="Roboto-Regular"
                        HorizontalOptions="Start"
                        ImageAlignment="Start"
                        ImageSource="facebook.png"
                        ShowIcon="True"
                        Stroke="#E5E1E3"
                        StrokeThickness="1"
                        Text="Facebook"
                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                    Dark={DynamicResource SecondaryTextColorDark}}"
                        WidthRequest="150" />
                </Grid>
                <HorizontalStackLayout
                    Grid.Row="7"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    VerticalOptions="End">
                    <Label
                        Margin="10,10,0,10"
                        FontFamily="Roboto-Regular"
                        HorizontalOptions="Center"
                        Text="Don't have an account?"
                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                    Dark={DynamicResource SecondaryTextColorDark}}"
                        VerticalOptions="Start" />
                    <button:SfButton
                        Margin="0,1,0,10"
                        Background="Transparent"
                        FontFamily="Roboto-Medium"
                        FontSize="14"
                        Text="Sign Up"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                    Dark={DynamicResource PrimaryColorDark}}" />
                </HorizontalStackLayout>
            </Grid>
        </ScrollView>
    </ContentPage.Content>

    <ContentPage.Behaviors>
        <beh:LoginBehavior />
    </ContentPage.Behaviors>



</ContentPage>