<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Garmetix.Onboarding.Pages.Step1BasicInformationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
    xmlns:local="clr-namespace:Garmetix.Onboarding.ViewModels"
    Title="{Binding Title}"
    x:DataType="local:Step1BasicInfoViewModel">
    <ScrollView>
        <Grid
            Padding="20"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="15">
            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                FontSize="Large"
                HorizontalOptions="Center"
                Text="Basic Information" />

            <Frame
                Grid.Row="1"
                Padding="15"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                BorderColor="{DynamicResource InputBorderColor}"
                CornerRadius="10"
                HasShadow="True">
                <dataForm:SfDataForm
                    x:Name="clientDetailsForm"
                    AutoGenerateItems="True"
                    ColumnCount="2"
                    CommitMode="PropertyChanged"
                    DataObject="{Binding ClientDetails}"
                    HorizontalOptions="Fill"
                    InputTransparent="True"
                    LayoutType="TextInputLayout"
                    MinimumHeightRequest="500"
                    ValidationMode="PropertyChanged"
                    VerticalOptions="Fill">

                    <dataForm:SfDataForm.TextInputLayoutSettings>
                        <dataForm:TextInputLayoutSettings
                            ContainerType="Outlined"
                            EnableHintAnimation="True"
                            FocusedStroke="Green"
                            OutlineCornerRadius="5"
                            ShowHelperText="True">
                            <dataForm:TextInputLayoutSettings.HelperTextStyle>
                                <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                            </dataForm:TextInputLayoutSettings.HelperTextStyle>
                        </dataForm:TextInputLayoutSettings>
                    </dataForm:SfDataForm.TextInputLayoutSettings>

                    <dataForm:SfDataForm.ErrorLabelTextStyle>
                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                    </dataForm:SfDataForm.ErrorLabelTextStyle>

                    <dataForm:SfDataForm.LabelTextStyle>
                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource Black}, Dark={DynamicResource White}}" />
                    </dataForm:SfDataForm.LabelTextStyle>

                    <dataForm:SfDataForm.ValidMessageLabelTextStyle>
                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                    </dataForm:SfDataForm.ValidMessageLabelTextStyle>

                    <dataForm:SfDataForm.EditorTextStyle>
                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource Black}, Dark={DynamicResource White}}" />
                    </dataForm:SfDataForm.EditorTextStyle>
                </dataForm:SfDataForm>
            </Frame>
            <Grid
                Grid.Row="2"
                Padding="20"
                ColumnSpacing="15"
                RowSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Command="{Binding NextStepCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Next" />

                <ActivityIndicator
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>