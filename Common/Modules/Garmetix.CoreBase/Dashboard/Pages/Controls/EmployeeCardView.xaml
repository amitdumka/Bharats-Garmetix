<?xml version="1.0" encoding="utf-8" ?>
<Border
    x:Class="Garmetix.CoreBase.Dashboard.Pages.Controls.EmployeeCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Garmetix.CoreBase.Dashboard.Pages.Controls"
    xmlns:models="clr-namespace:Garmetix.Models.Dashboards;assembly=Garmetix.Models"
    xmlns:pageModels="clr-namespace:Garmetix.CoreBase.Dashboard.PageModels"
    xmlns:shimmer="clr-namespace:Syncfusion.Maui.Toolkit.Shimmer;assembly=Syncfusion.Maui.Toolkit"
    x:DataType="models:EmployeeInfo"
    Style="{StaticResource CardStyle}">
    <shimmer:SfShimmer
        BackgroundColor="Transparent"
        IsActive="{Binding IsLoading, Source={RelativeSource AncestorType={x:Type pageModels:DefaultDashboardPageModel}}, x:DataType=pageModels:DefaultDashboardPageModel}"
        VerticalOptions="Fill">
        <shimmer:SfShimmer.CustomView>
            <VerticalStackLayout Spacing="15">
                <BoxView
                    CornerRadius="48"
                    HeightRequest="24"
                    HorizontalOptions="Start"
                    Style="{StaticResource ShimmerCustomViewStyle}"
                    VerticalOptions="Start"
                    WidthRequest="24" />
                <BoxView HeightRequest="24" Style="{StaticResource ShimmerCustomViewStyle}" />
                <BoxView HeightRequest="48" Style="{StaticResource ShimmerCustomViewStyle}" />
                <BoxView
                    Margin="0,12"
                    HeightRequest="24"
                    Style="{StaticResource ShimmerCustomViewStyle}" />
            </VerticalStackLayout>
        </shimmer:SfShimmer.CustomView>
        <shimmer:SfShimmer.Content>
            <VerticalStackLayout Spacing="15">
                <Label
                    FontSize="14"
                    Text="{Binding Name}"
                    TextColor="{StaticResource Gray400}"
                    TextTransform="Uppercase" />
                <Label LineBreakMode="WordWrap" Text="{Binding TodayAttendance, StringFormat='Today:{0}'}" />
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding NoofDayPresent, StringFormat='Count:{0}'}" />
                    <Label Text="{Binding MonthlySale, StringFormat='Sales:{0}'}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </shimmer:SfShimmer.Content>
    </shimmer:SfShimmer>
</Border>